# Delta lake output — regenerated by the pipeline, never committed
data/

# Run logs — machine-local, regenerated every run
.runs/

# Verification baselines are generated, not authored
tests/baselines/*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Local overrides — machine-specific, must not be shared
.claude/settings.local.json
.env

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Spark
spark-warehouse/
metastore_db/
derby.log
